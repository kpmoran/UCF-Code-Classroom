# ---------------------------------------------------------------------------
# Production environment. Lives at /opt/uccc/.env ON THE SERVER ONLY.
#
# bootstrap.sh generates this with fresh secrets. Never commit a filled-in copy;
# never paste it into a chat, an issue, or a GitHub secret. The deploy workflow
# deliberately does not touch this file, so the secrets have exactly one home.
# ---------------------------------------------------------------------------

# --- Public identity -------------------------------------------------------
# The domain students visit. Must match DNS and the GitHub App's callback URL.
APP_DOMAIN="code-connect.example.edu"
APP_URL="https://code-connect.example.edu"

# --- Database --------------------------------------------------------------
# `postgres` is the compose service name, not localhost: the app talks to it over
# the compose network. Pointing this at localhost is the most common way to get a
# container that boots and then 503s on every page.
POSTGRES_USER="uccc"
POSTGRES_PASSWORD="__GENERATED__"
POSTGRES_DB="uccc"
DATABASE_URL="postgresql://uccc:__GENERATED__@postgres:5432/uccc?schema=public"

# --- Auth.js ---------------------------------------------------------------
AUTH_SECRET="__GENERATED__"

# OAuth credentials of the GitHub App. Callback URL must be
# https://$APP_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- GitHub App ------------------------------------------------------------
GITHUB_APP_ID=""
# The .pem as a single line with literal \n escapes:
#   awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=""

# Webhook secret. Set the same value in the App's webhook settings, with URL
# https://$APP_DOMAIN/api/webhooks/github
GITHUB_WEBHOOK_SECRET="__GENERATED__"

# --- Encryption ------------------------------------------------------------
# Decrypts every stored instructor OAuth token. Losing it means every instructor
# reconnects; leaking it hands over admin:org on your GitHub organization.
# Back it up somewhere you would trust with a password.
ENCRYPTION_KEY="__GENERATED__"

# --- Rate limiting ---------------------------------------------------------
# GitHub's documented secondary limits are 80 content-creating requests per
# minute and 500 per hour. Do not raise these.
GITHUB_CONTENT_CALLS_PER_MINUTE="6"
GITHUB_CONTENT_CALLS_PER_HOUR="400"

# --- Worker ----------------------------------------------------------------
# One container serves pages and runs the job worker. Leave true unless you split
# them, in which case exactly one process should have it true.
RUN_WORKER="true"

NODE_ENV="production"
RUN_MIGRATIONS="true"
