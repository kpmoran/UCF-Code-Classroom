# ---------------------------------------------------------------------------
# UCF-Code-Connect environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#   cp .env.example .env
#
# See README.md "GitHub App setup" for how to obtain the GITHUB_APP_* values.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://uccc:uccc_dev_password@localhost:5433/uccc?schema=public"

# --- App -------------------------------------------------------------------
# Public origin of this app. Used to build OAuth callback and webhook URLs.
APP_URL="http://localhost:3000"

# --- Auth.js ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# OAuth App credentials, used to sign users in.
# NOTE: this is the *OAuth* client of your GitHub App (Settings -> your App),
# not a separate OAuth App. Callback URL: {APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- GitHub App ------------------------------------------------------------
# Numeric App ID from the App's settings page.
GITHUB_APP_ID=""

# The App's private key (.pem download), as a single line with literal \n
# escapes, OR a base64 blob. Convert a .pem to a single line with:
#   awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=""

# Webhook secret you set when registering the App.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=""

# --- Encryption ------------------------------------------------------------
# AES-256-GCM key for encrypting stored instructor OAuth tokens at rest.
# Must be 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
#
# WARNING: changing this makes every stored token undecryptable. Instructors
# would have to reconnect their GitHub accounts.
ENCRYPTION_KEY=""

# --- Rate limiting ---------------------------------------------------------
# GitHub's documented secondary limits are 80 content-creating requests per
# minute and 500 per hour. We stay well under both. Lower these if you start
# seeing 403 secondary-limit responses; do not raise them.
GITHUB_CONTENT_CALLS_PER_MINUTE="6"
GITHUB_CONTENT_CALLS_PER_HOUR="400"

# --- Worker ----------------------------------------------------------------
# Whether this process should run the pg-boss job worker. Set to "false" on
# serverless deployments (e.g. Vercel), where the worker must run separately.
RUN_WORKER="true"
