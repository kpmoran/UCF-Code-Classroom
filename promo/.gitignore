# Intermediates, regenerated by capture.mjs from the running app: about six
# megabytes of screenshots and 4K scene renders.
shots/
scenes/

# Build outputs. The video that ships is committed once, as public/promo.mp4 —
# keeping a second copy here would put the same three megabytes in git twice and
# leave two files that could disagree about which is current. Rebuild with
# build-video.sh; the 720p copy and the poster come out of the same run.
*.mp4
poster.png
